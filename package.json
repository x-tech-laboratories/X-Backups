{
  "name": "x-backups",
  "private": true,
  "version": "0.1.0",
  "description": "A web platform for managing borg backups",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "X_BACKUPS_CONFIG=${X_BACKUPS_CONFIG:-config.example.json} X_BACKUPS_PASSWORD_HASH_FILE=${X_BACKUPS_PASSWORD_HASH_FILE:-password.hash} node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node src/server/main.ts",
    "test": "vitest run",
    "hash-password": "node src/server/hash_password.ts",
    "import-x-monitor": "node src/server/import_x_monitor.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
